# ============================================
# Hanuvansh CRM Frontend - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# Local Development:
REACT_APP_API_URL=http://localhost:5000

# Production (set in Netlify environment variables):
# REACT_APP_API_URL=https://hanuvansh-crm-backend.onrender.com

# --------------------------------------------
# IMPORTANT NOTES
# --------------------------------------------
# 1. All React environment variables MUST start with REACT_APP_
# 2. Changes require restarting the development server
# 3. In production, set this in Netlify dashboard, not in this file
