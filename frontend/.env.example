# ============================================
# Hanuvansh CRM Frontend - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit the .env file to version control

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# REACT_APP_API_URL: The base URL of the backend API server
#
# Development (local backend):
#   http://localhost:5000
#
# Production:
#   https://your-backend-domain.com
#
# IMPORTANT: All React environment variables must start with REACT_APP_
# Changes to this file require restarting the development server
REACT_APP_API_URL=http://localhost:5000

# --------------------------------------------
# Optional: Feature Flags
# --------------------------------------------
# Uncomment to enable/disable features
# REACT_APP_ENABLE_REGISTRATION=true
# REACT_APP_ENABLE_PASSWORD_RESET=false

# --------------------------------------------
# Optional: Analytics
# --------------------------------------------
# Uncomment to enable analytics tracking
# REACT_APP_ANALYTICS_ID=your_analytics_id_here
