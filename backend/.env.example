# ============================================
# Hanuvansh CRM Backend - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit the .env file to version control

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# PORT: The port number on which the backend server will run
# Default: 5000
PORT=5000

# NODE_ENV: Environment mode (development, production, test)
# - development: Enables detailed error messages and logging
# - production: Optimized for performance, minimal logging
# - test: Used for running automated tests
NODE_ENV=development

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# MONGODB_URI: MongoDB connection string
# 
# Local MongoDB:
#   mongodb://localhost:27017/hanuvansh-crm
#
# MongoDB Atlas (Cloud):
#   mongodb+srv://username:password@cluster.mongodb.net/hanuvansh-crm
#
# Replace 'hanuvansh-crm' with your preferred database name
MONGODB_URI=mongodb://localhost:27017/hanuvansh-crm

# --------------------------------------------
# JWT (JSON Web Token) Configuration
# --------------------------------------------
# JWT_SECRET: Secret key used to sign and verify JWT tokens
# SECURITY: Use a strong, random string (minimum 32 characters)
# 
# Generate a secure secret using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NEVER use the default value in production!
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_recommended

# JWT_EXPIRE: Token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 15m, 1h, 7d, 30d
# Recommended: 15m for access tokens (use refresh tokens for longer sessions)
JWT_EXPIRE=15m

# --------------------------------------------
# Optional: CORS Configuration
# --------------------------------------------
# Uncomment and set if you need to restrict CORS to specific origins
# CORS_ORIGIN=http://localhost:3000

# --------------------------------------------
# Optional: Rate Limiting
# --------------------------------------------
# Uncomment to enable rate limiting (requests per window)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
