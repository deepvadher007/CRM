# ============================================
# Hanuvansh CRM Backend - Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# IMPORTANT: Never commit the .env file to version control

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=5000
NODE_ENV=development

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# LOCAL DEVELOPMENT: Use local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hanuvanshCRM

# PRODUCTION (Render): Use MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hanuvanshCRM?retryWrites=true&w=majority

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
# JWT_SECRET: MUST be minimum 32 characters for security
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_required_here

# JWT_EXPIRE: Token expiration time (3h = 3 hours)
JWT_EXPIRE=3h

# --------------------------------------------
# CORS Configuration (Reference Only)
# --------------------------------------------
# The following origins are hardcoded in server.js for security:
# - https://crm.hanuvanshrealty.com (production)
# - http://localhost:3000 (local development)
CLIENT_URL=http://localhost:3000

# --------------------------------------------
# NOTES
# --------------------------------------------
# 1. Local MongoDB will auto-create the database on first use
# 2. Ensure MongoDB is installed and running locally
# 3. Production uses MongoDB Atlas (set in Render environment variables)
